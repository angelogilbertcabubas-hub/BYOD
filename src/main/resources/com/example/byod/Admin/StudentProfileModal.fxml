<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<?import java.lang.String?>

<VBox prefHeight="620.0" prefWidth="820.0" spacing="15.0"
      style="-fx-background-color: #E5E1E2; -fx-padding: 20;"
      stylesheets="@style.css"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Admin.StudentProfileModalController">
    <children>

        <HBox alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;">
            <children>
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblFullNameHeader" style="-fx-text-fill: #500A0E; -fx-font-weight: bold; -fx-font-size: 18px;" text="Student Profile Matrix" />
                        <Label fx:id="lblStudentNumberSub" style="-fx-text-fill: #777777; -fx-font-size: 12px;"
                               text="Student Account Profile Management Node" />
                    </children>
                </VBox>
                <HBox spacing="10.0">
                    <Button fx:id="btnClearSanctions" mnemonicParsing="false" onAction="#handleClearSanctions" style="-fx-background-color: #E67E22; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 15;"
                            text="🔄 LIFT RESTRICTION" />
                    <Button mnemonicParsing="false" onAction="#handleRemoveStudent" style="-fx-background-color: #D32F2F; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 8 15;"
                            text="❌ REMOVE STUDENT" />
                </HBox>
            </children>
        </HBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;"
                    VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="15.0">
                    <children>
                        <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20;">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label style="-fx-text-fill: #500A0E; -fx-font-weight: bold; -fx-font-size: 14px;"
                                               text="Account Dossier Details" HBox.hgrow="ALWAYS" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnEditToggle" mnemonicParsing="false" onAction="#handleEditToggle" style="-fx-background-color: #E2DDD9; -fx-text-fill: #333333; -fx-font-weight: bold; -fx-font-size: 11px; -fx-background-radius: 4;
-fx-cursor: hand; -fx-padding: 6 14;" text="✏ EDIT" />
                                        <Button fx:id="btnSaveEdit" mnemonicParsing="false" onAction="#handleSaveEdit" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 6 14;"
                                                text="✔ SAVE" visible="false" managed="false" />
                                        <Button fx:id="btnCancelEdit" mnemonicParsing="false" onAction="#handleCancelEdit" style="-fx-background-color: #888888; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-background-radius: 4; -fx-cursor: hand; -fx-padding: 6 14;"
                                                text="✖ CANCEL" visible="false" managed="false" />
                                    </children>
                                </HBox>

                                <Separator />

                                <HBox alignment="CENTER_LEFT" spacing="20.0">
                                    <children>
                                        <VBox alignment="CENTER" spacing="5.0" style="-fx-border-color: #E2DDD9; -fx-border-radius: 6; -fx-padding: 10;">
                                            <children>
                                                <StackPane style="-fx-border-color: #DDDDDD; -fx-border-radius: 50; -fx-background-radius: 50; -fx-background-color: #F9F9F9; -fx-padding: 5;">
                                                    <ImageView fx:id="studentCloudPhotoView" fitHeight="100.0" fitWidth="100.0" preserveRatio="false">
                                                        <clip>
                                                            <Circle centerX="50.0" centerY="50.0" radius="50.0" />
                                                        </clip>
                                                    </ImageView>
                                                </StackPane>
                                                <Label style="-fx-font-size: 10px; -fx-text-fill: #777777;
-fx-font-weight: bold;" text="STUDENT PHOTO" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <GridPane fx:id="viewModeGrid" hgap="15.0" vgap="10.0">
                                                    <columnConstraints>
                                                        <ColumnConstraints hgrow="NEVER" minWidth="120.0" prefWidth="130.0" />
                                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" />
                                                    </columnConstraints>
                                                    <rowConstraints>
                                                        <RowConstraints minHeight="25.0" />
                                                        <RowConstraints minHeight="25.0" />
                                                        <RowConstraints minHeight="25.0" />
                                                        <RowConstraints minHeight="25.0" />
                                                    </rowConstraints>
                                                    <children>
                                                        <Label style="-fx-text-fill: #777777;
-fx-font-weight: bold;" text="STUDENT NUMBER:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                                                        <Label fx:id="txtProfileId" style="-fx-font-weight: bold;
-fx-text-fill: #222222;" text="---" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                                                        <Label style="-fx-text-fill: #777777;
-fx-font-weight: bold;" text="COURSE MODULE:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                                                        <Label fx:id="txtProfileCourse" style="-fx-text-fill: #222222;" text="---" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                        <Label style="-fx-text-fill: #777777;
-fx-font-weight: bold;" text="EMAIL ADDRESS:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                                        <Label fx:id="txtProfileEmail" style="-fx-text-fill: #222222;" text="---" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                                        <Label style="-fx-text-fill: #777777;
-fx-font-weight: bold;" text="MOBILE LINK:" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                                        <Label fx:id="txtProfileMobile" style="-fx-text-fill: #222222;" text="---" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                                                    </children>
                                                </GridPane>

                                                <GridPane fx:id="editModeGrid" hgap="15.0" vgap="10.0" visible="false" managed="false">
                                                    <columnConstraints>
                                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                                    </columnConstraints>
                                                    <rowConstraints>
                                                        <RowConstraints minHeight="55.0" />
                                                        <RowConstraints minHeight="55.0" />
                                                    </rowConstraints>
                                                    <children>
                                                        <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                                            <children>
                                                                <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #555555;" text="COURSE MODULE" />
                                                                <TextField fx:id="editCourseField" promptText="e.g. BSIT" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2DDD9; -fx-border-radius: 6; -fx-pref-height: 38;" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                                            <children>
                                                                <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #555555;" text="EMAIL ADDRESS" />
                                                                <TextField fx:id="editEmailField" promptText="e.g. student@pup.edu.ph" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2DDD9; -fx-border-radius: 6; -fx-pref-height: 38;" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="4.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                                            <children>
                                                                <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #555555;" text="MOBILE LINK" />
                                                                <TextField fx:id="editMobileField" promptText="e.g. 09XXXXXXXXX" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2DDD9; -fx-border-radius: 6; -fx-pref-height: 38;" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="4.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                                            <children>
                                                                <Label style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #555555;" text="STUDENT NUMBER (read-only)" />
                                                                <TextField fx:id="editStudentIdField" style="-fx-background-color: #F0F0F0; -fx-border-color: #E2DDD9; -fx-border-radius: 6; -fx-pref-height: 38; -fx-text-fill: #999999;" editable="false" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </GridPane>
                                            </children>
                                        </VBox>

                                        <VBox alignment="CENTER" spacing="5.0" style="-fx-border-color: #E2DDD9; -fx-border-radius: 6; -fx-padding: 8;">
                                            <children>
                                                <ImageView fx:id="qrCodeImageView" fitHeight="110.0" fitWidth="110.0" preserveRatio="true" />
                                                <Label style="-fx-font-size: 10px; -fx-text-fill: #777777; -fx-font-weight: bold;" text="ASSIGNED QR" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20;">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label style="-fx-text-fill: #500A0E; -fx-font-weight: bold; -fx-font-size: 14px;" text="Registered Authorized Devices" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Button mnemonicParsing="false" onAction="#handleRemoveSelectedDevice" style="-fx-background-color: transparent; -fx-border-color: #D32F2F; -fx-border-radius: 4; -fx-text-fill: #D32F2F; -fx-font-weight: bold; -fx-cursor: hand;" text="🗑 Delete Selected Asset" />
                                    </children>
                                </HBox>
                                <Separator />

                                <TableView fx:id="deviceMatrixTable" prefHeight="170.0" styleClass="modal-table-header" style="-fx-control-inner-background: white;">
                                    <columns>
                                        <TableColumn fx:id="colType" prefWidth="110.0" text="ASSET TYPE" />
                                        <TableColumn fx:id="colModel" prefWidth="160.0" text="BRAND &amp; MODEL" />
                                        <TableColumn fx:id="colSerialNumber" prefWidth="160.0" text="SERIAL NUMBER" />
                                        <TableColumn fx:id="colToken" prefWidth="110.0" text="SECURITY TOKEN" />
                                    </columns>
                                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY" /></columnResizePolicy>
                                </TableView>

                                <VBox alignment="CENTER" spacing="10.0" style="-fx-border-color: #E2DDD9; -fx-border-radius: 6; -fx-padding: 15;">
                                    <children>
                                        <Label style="-fx-font-size: 11px; -fx-text-fill: #500A0E; -fx-font-weight: bold;" text="DEVICE PREVIEW" />
                                        <ImageView fx:id="devicePhotoImageView" fitWidth="600.0" preserveRatio="true" VBox.vgrow="ALWAYS" />
                                    </children>
                                </VBox>

                                <Label style="-fx-text-fill: #500A0E; -fx-font-weight: bold; -fx-font-size: 12px;" text="⚡ Provision New Asset Attachment" />
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <ComboBox fx:id="quickTypeBox" prefHeight="35.0" prefWidth="120.0" promptText="Type" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 4;" />
                                        <TextField fx:id="quickModelField" prefHeight="35.0" promptText="Brand/Model" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 4;" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="quickSerialNumberField" prefHeight="35.0" prefWidth="130.0" promptText="Serial No. / NA" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 4;" />
                                        <Button mnemonicParsing="false" onAction="#handleQuickUploadPhoto" prefHeight="35.0" style="-fx-background-color: #DDDDDD; -fx-cursor: hand;" text="📷" />
                                        <Button mnemonicParsing="false" onAction="#handleQuickAddDevice" prefHeight="35.0" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-cursor: hand;" text="+ Link Asset" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>

        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 5 0 0 0;">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCloseModal" prefHeight="38.0" prefWidth="110.0" style="-fx-background-color: #500A0E; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="CLOSE VIEW" />
            </children>
        </HBox>

    </children>
</VBox>
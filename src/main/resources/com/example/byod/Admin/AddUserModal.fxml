<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox prefWidth="520.0" spacing="15.0" style="-fx-background-color: #E5E1E2; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Admin.AddUserController">
    <children>
        <VBox spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;">
            <children>
                <Label style="-fx-text-fill: #500A0E; -fx-font-weight: bold; -fx-font-size: 18px;" text="Register New User" />
                <Label style="-fx-text-fill: #777777; -fx-font-size: 12px;" text="Create new administrative or security staff credential profiles." />
            </children>
        </VBox>

        <VBox spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20;">
            <children>
                <Label style="-fx-text-fill: #500A0E; -fx-font-weight: bold; -fx-font-size: 15px;" text="User Information" />
                <Separator />

                <VBox spacing="5.0">
                    <Label style="-fx-text-fill: #555555; -fx-font-weight: bold; -fx-font-size: 11px;" text="USERNAME *" />
                    <TextField fx:id="txtUsername" prefHeight="38.0" promptText="e.g., admin_new" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label style="-fx-text-fill: #555555; -fx-font-weight: bold; -fx-font-size: 11px;" text="FULL NAME *" />
                    <TextField fx:id="txtFullName" prefHeight="38.0" promptText="e.g., Juan Dela Cruz" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                </VBox>

                <VBox spacing="5.0">
                    <Label style="-fx-text-fill: #555555; -fx-font-weight: bold; -fx-font-size: 11px;" text="SYSTEM ROLE *" />
                    <ComboBox fx:id="cmbRole"
                              prefHeight="38.0"
                              prefWidth="Infinity"
                              promptText="Select Role"
                              style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                </VBox>
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="15.0" style="-fx-padding: 10 0 0 0;">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="40.0" prefWidth="100.0" style="-fx-background-color: white; -fx-text-fill: #444444; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand; -fx-border-color: #CCCCCC; -fx-border-radius: 6;" text="CANCEL" />
                <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #500A0E; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;" text="CREATE USER" />
            </children>
        </HBox>
    </children>
</VBox>

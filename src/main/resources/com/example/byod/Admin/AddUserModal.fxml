<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="520.0" spacing="20.0" style="-fx-background-color: #E5E1E2; -fx-padding: 25;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Admin.AddUserController">
    <children>
        <VBox spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;">
            <children>
                <Label text="Provision New User" textFill="#500A0E">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Label>
                <Label text="Create a new administrative or security staff credentials profile." textFill="#666666">
                    <font><Font size="11.0" /></font>
                </Label>
            </children>
        </VBox>

        <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20;" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="USERNAME *" textFill="#555555">
                            <font><Font name="System Bold" size="10.0" /></font>
                        </Label>
                        <TextField fx:id="txtUsername" prefHeight="35.0" promptText="e.g., admin_new" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label text="FULL NAME *" textFill="#555555">
                            <font><Font name="System Bold" size="10.0" /></font>
                        </Label>
                        <TextField fx:id="txtFullName" prefHeight="35.0" promptText="e.g., Juan Dela Cruz" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                    </children>
                </VBox>

                <GridPane hgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="240.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="105.0" minWidth="10.0" prefWidth="15.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="210.0" minWidth="10.0" prefWidth="210.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="55.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <VBox spacing="4.0" GridPane.columnIndex="0">
                            <children>
                                <Label text="SYSTEM ROLE *" textFill="#555555">
                                    <font><Font name="System Bold" size="10.0" /></font>
                                </Label>
                                <TextField fx:id="txtRole" prefHeight="35.0" promptText="Administrator or Security Guard" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                            </children>
                        </VBox>
                        <VBox prefHeight="55.0" prefWidth="159.0" spacing="4.0" GridPane.columnIndex="2" />
                    </children>
                </GridPane>
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="35.0" prefWidth="90.0" style="-fx-background-color: white; -fx-text-fill: #444444; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;" text="CANCEL" />
                <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #500A0E; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;" text="CREATE USER" />
            </children>
        </HBox>
    </children>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefWidth="480.0" spacing="15.0" style="-fx-background-color: #FFFFFF; -fx-padding: 30; -fx-background-radius: 12; -fx-border-color: #E2DDD9; -fx-border-radius: 12;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Admin.AddDeviceController">

    <Label text="Register Hardware Asset" textFill="#500A0E">
        <font><Font name="System Bold" size="20.0" /></font>
    </Label>
    <Label prefHeight="34.0" prefWidth="351.0" text="Map a new device to an existing enrolled student. Photo previews are required for security logging."
           textAlignment="CENTER" textFill="#777777" wrapText="true">
        <font><Font size="12.0" /></font>
        <VBox.margin><Insets bottom="10.0" /></VBox.margin>
    </Label>

    <VBox alignment="CENTER" spacing="8.0">
        <StackPane maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="182.0" prefWidth="182.0" style="-fx-border-color: #DDDDDD; -fx-border-width: 1; -fx-background-radius: 7; -fx-border-radius: 7; -fx-padding: 0;">
            <ImageView fx:id="devicePhotoPreview" fitHeight="190.0" fitWidth="190.0" pickOnBounds="true" preserveRatio="true">
                <clip>
                    <javafx.scene.shape.Rectangle arcHeight="7.0" arcWidth="7.0" height="180.0" width="180.0" />
                </clip>
            </ImageView>
        </StackPane>

        <Button mnemonicParsing="false" onAction="#handleUploadDevicePhoto" style="-fx-background-color: #E67E22; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 6 12;"
                text="Browse Photo" />
        <Label fx:id="lblDevicePhotoName" style="-fx-font-size: 10px; -fx-text-fill: #777777;"
               text="No file selected" />
    </VBox>

    <Separator prefWidth="200.0" />

    <VBox spacing="12.0">
        <VBox spacing="5.0">
            <Label text="Student Owner *" textFill="#500A0E"><font><Font name="System Bold" size="11.0" /></font></Label>
            <ComboBox fx:id="cmbOwnerName" editable="true" prefHeight="35.0" prefWidth="Infinity" promptText="Select a registered student" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
        </VBox>

        <GridPane hgap="15.0" vgap="12.0">
            <columnConstraints>
                <ColumnConstraints percentWidth="50.0" />
                <ColumnConstraints percentWidth="50.0" />
            </columnConstraints>
            <children>
                <VBox spacing="5.0" GridPane.columnIndex="0">
                    <Label text="Device Type *" textFill="#500A0E"><font><Font name="System Bold" size="11.0" /></font></Label>
                    <ComboBox fx:id="cmbDeviceType" prefHeight="35.0" prefWidth="Infinity" promptText="Select Type" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                </VBox>
                <VBox spacing="5.0" GridPane.columnIndex="1">
                    <Label text="Serial Number" textFill="#500A0E"><font><Font name="System Bold" size="11.0" /></font></Label>
                    <TextField fx:id="txtSerialNumber" prefHeight="35.0" promptText="e.g. SN123456789 or N/A" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                </VBox>
            </children>
            <rowConstraints>
                <RowConstraints />
            </rowConstraints>
        </GridPane>

        <VBox spacing="5.0">
            <Label text="Brand &amp; Model Description *" textFill="#500A0E"><font><Font name="System Bold" size="11.0" /></font></Label>
            <TextField fx:id="txtModel" prefHeight="35.0" promptText="e.g. Dell Inspiron 15" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
        </VBox>
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="35.0" style="-fx-background-color: transparent; -fx-text-fill: #777777; -fx-cursor: hand; -fx-font-weight: bold;" text="Cancel" />
        <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="35.0" style="-fx-background-color: #500A0E; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 0 20;" text="Save Hardware" />
    </HBox>
</VBox>
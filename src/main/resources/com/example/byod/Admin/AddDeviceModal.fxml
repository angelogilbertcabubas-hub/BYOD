<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefWidth="480.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 12;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Admin.AddDeviceController">

    <Label text="Register Hardware Asset" textFill="#500A0E">
        <font><Font name="System Bold" size="20.0" /></font>
    </Label>
    <Label text="Map a new device to an existing enrolled student. Photo previews are required for security logging." textAlignment="CENTER" textFill="#777777" wrapText="true">
        <font><Font size="12.0" /></font>
        <VBox.margin><Insets bottom="10.0" /></VBox.margin>
    </Label>

    <HBox alignment="CENTER" spacing="20.0">
        <VBox alignment="CENTER" spacing="12.0">
            <StackPane prefHeight="160.0" prefWidth="160.0" style="-fx-border-color: #DDDDDD; -fx-border-radius: 8; -fx-background-radius: 8; -fx-background-color: #F9F9F9;">
                <ImageView fx:id="devicePhotoPreview" fitHeight="150.0" fitWidth="150.0" pickOnBounds="true" preserveRatio="true" />
            </StackPane>
            <Button mnemonicParsing="false" onAction="#handleUploadDevicePhoto" style="-fx-background-color: #E67E22; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 6 12 6 12;" text="Browse Photo" />
            <Label fx:id="lblDevicePhotoName" style="-fx-font-size: 10px; -fx-text-fill: #777777;" text="No file selected" />
        </VBox>
    </HBox>

    <Separator prefWidth="200.0">
        <VBox.margin><Insets bottom="5.0" top="5.0" /></VBox.margin>
    </Separator>

    <VBox spacing="5.0">
        <Label text="Student Owner *" textFill="#555555"><font><Font name="System Bold" size="11.0" /></font></Label>
        <ComboBox fx:id="cmbOwnerName" prefHeight="35.0" prefWidth="Infinity" promptText="Select a registered student" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;"/>
    </VBox>

    <GridPane hgap="15.0" vgap="15.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="50.0" />
            <ColumnConstraints percentWidth="50.0" />
        </columnConstraints>

        <VBox spacing="5.0" GridPane.columnIndex="0">
            <Label text="Device Type *" textFill="#555555"><font><Font name="System Bold" size="11.0" /></font></Label>
            <ComboBox fx:id="cmbDeviceType" prefHeight="35.0" prefWidth="Infinity" promptText="Select Type" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;"/>
        </VBox>

        <VBox spacing="5.0" GridPane.columnIndex="1">
            <Label text="MAC Address" textFill="#555555"><font><Font name="System Bold" size="11.0" /></font></Label>
            <TextField fx:id="txtMacAddress" prefHeight="35.0" promptText="00:1B:44:11:3A:B7 or N/A" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
        </VBox>

        <VBox spacing="5.0" GridPane.columnSpan="2" GridPane.rowIndex="1">
            <Label text="Brand &amp; Model Description *" textFill="#555555"><font><Font name="System Bold" size="11.0" /></font></Label>
            <TextField fx:id="txtModel" prefHeight="35.0" promptText="e.g. Dell Inspiron 15" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
        </VBox>
        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>
    </GridPane>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="35.0" style="-fx-background-color: transparent; -fx-text-fill: #555555; -fx-cursor: hand; -fx-font-weight: bold;" text="Cancel" />
        <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="35.0" style="-fx-background-color: #500A0E; -fx-text-fill: white; -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold; -fx-padding: 0 20 0 20;" text="Save Hardware" />
    </HBox>
</VBox>
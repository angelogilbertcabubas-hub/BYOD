<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="520.0" spacing="20.0" style="-fx-background-color: #E5E1E2; -fx-padding: 25;"
      xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Admin.AddDeviceController">
    <children>
        <VBox spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;">
            <children>
                <Label text="Register New Hardware Asset" textFill="#500A0E">
                    <font><Font name="System Bold" size="16.0" /></font>
                </Label>
            </children>
        </VBox>

        <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20;"
              VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="SEARCH AND SELECT REGISTERED STUDENT *" textFill="#555555">
                            <font><Font name="System Bold" size="10.0" /></font>
                        </Label>
                        <ComboBox fx:id="cmbOwnerName" editable="true" prefHeight="35.0" prefWidth="Infinity" promptText="Start typing student name or ID..." style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label text="BRAND &amp; MODEL DESCRIPTION *" textFill="#555555">
                            <font><Font name="System Bold" size="10.0" /></font>
                        </Label>
                        <TextField fx:id="txtModel" prefHeight="35.0" promptText="e.g., Asus ROG Zephyrus G14" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                    </children>
                </VBox>

                <GridPane hgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="105.0" minWidth="10.0" prefWidth="33.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="194.0" minWidth="10.0" prefWidth="194.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="55.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <VBox spacing="4.0" GridPane.columnIndex="0">
                            <children>
                                <Label text="DEVICE TYPE *" textFill="#555555">
                                    <font><Font name="System Bold" size="10.0" /></font>
                                </Label>
                                <ComboBox fx:id="cmbDeviceType" prefHeight="35.0" prefWidth="Infinity" promptText="Select Category" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                            </children>
                        </VBox>

                        <VBox prefHeight="55.0" prefWidth="159.0" spacing="4.0" GridPane.columnIndex="2">
                            <children>
                                <Label text="PHYSICAL MAC ADDRESS *" textFill="#555555">
                                    <font><Font name="System Bold" size="10.0" /></font>
                                </Label>
                                <TextField fx:id="txtMacAddress" prefHeight="35.0" promptText="e.g., 00:1B:44:11:3A:B7" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                            </children>
                        </VBox>
                    </children>
                </GridPane>
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancel" prefHeight="35.0" prefWidth="90.0" style="-fx-background-color: white; -fx-text-fill: #444444; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;" text="CANCEL" />
                <Button mnemonicParsing="false" onAction="#handleSave" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #500A0E; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;" text="REGISTER DEVICE" />
            </children>
        </HBox>
    </children>
</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox prefHeight="550" prefWidth="420" spacing="12" style="-fx-background-color: white; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Admin.DeviceProfileModalController">

    <Label fx:id="lblDeviceHeader" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #500A0E;" />
    <Label fx:id="lblStudentOwnerSummary" style="-fx-text-fill: #555555; -fx-font-size: 12px;" />

    <VBox alignment="CENTER" spacing="8">
        <StackPane maxHeight="-Infinity" maxWidth="-Infinity" style="-fx-border-color: #DDDDDD; -fx-border-width: 1; -fx-background-radius: 7; -fx-border-radius: 7; -fx-padding: 2;">
            <ImageView fx:id="devicePhotoImageView" fitHeight="190.0" fitWidth="190.0" pickOnBounds="true" preserveRatio="true">
                <clip>
                    <Rectangle arcHeight="7.0" arcWidth="7.0" height="190.0" width="190.0" />
                </clip>
            </ImageView>
        </StackPane>
        <Button onAction="#handleUpdatePhoto" style="-fx-background-color: #E67E22; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 5 15;" text="Change Photo" />
    </VBox>

    <VBox spacing="8" style="-fx-padding: 5 0 0 0;">
        <Label style="-fx-font-weight: bold;" text="Type:" />
        <ComboBox fx:id="cmbEditType" maxWidth="Infinity" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />

        <Label style="-fx-font-weight: bold;" text="Model Description:" />
        <TextField fx:id="txtEditModel" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />

        <Label style="-fx-font-weight: bold;" text="MAC Address:" />
        <TextField fx:id="txtEditMac" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
    </VBox>

    <Region VBox.vgrow="ALWAYS" />

    <HBox alignment="BOTTOM_RIGHT" spacing="10">
        <Button onAction="#handleCancel" style="-fx-background-color: transparent; -fx-font-weight: bold;" text="Cancel" />
        <Button onAction="#handleSaveChanges" style="-fx-background-color: #500A0E; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-padding: 5 20;" text="Save Changes" />
    </HBox>
</VBox>
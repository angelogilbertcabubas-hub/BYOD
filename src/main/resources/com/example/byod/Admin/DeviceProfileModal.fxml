<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.Admin.DeviceProfileModalController" prefWidth="400" prefHeight="500">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="lblDeviceHeader" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <Label fx:id="lblStudentOwnerSummary" style="-fx-text-fill: #555555;"/>

    <ImageView fx:id="devicePhotoImageView" fitWidth="200" fitHeight="200" preserveRatio="true" />
    <Button text="Change Photo" onAction="#handleUpdatePhoto" />

    <GridPane vgap="10" hgap="10">
        <Label text="Type:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="cmbEditType" GridPane.rowIndex="0" GridPane.columnIndex="1" maxWidth="Infinity"/>

        <Label text="Model:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEditModel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="MAC:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEditMac" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="BOTTOM_RIGHT">
        <Button text="Save Changes" onAction="#handleSaveChanges" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
    </HBox>
</VBox>
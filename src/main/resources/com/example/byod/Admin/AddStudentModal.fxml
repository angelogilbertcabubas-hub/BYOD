<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="520.0" spacing="20.0" style="-fx-background-color: #E5E1E2; -fx-padding: 25;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.Admin.AddStudentController">
    <children>
        <VBox spacing="4.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 15;">
            <children>
                <Label text="Register New Student" textFill="#500A0E"><font><Font name="System Bold" size="16.0" /></font></Label>
            </children>
        </VBox>

        <VBox spacing="12.0" style="-fx-background-color: white; -fx-background-radius: 8; -fx-padding: 20;" VBox.vgrow="ALWAYS">
            <children>
                <VBox spacing="4.0">
                    <children>
                        <Label text="FIRST NAME *" textFill="#555555"><font><Font name="System Bold" size="10.0" /></font></Label>
                        <TextField fx:id="firstNameField" prefHeight="35.0" promptText="Enter student's first name" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label text="MIDDLE NAME" textFill="#555555"><font><Font name="System Bold" size="10.0" /></font></Label>
                        <TextField fx:id="middleNameField" prefHeight="35.0" promptText="Enter student's middle name (optional)" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label text="LAST NAME *" textFill="#555555"><font><Font name="System Bold" size="10.0" /></font></Label>
                        <TextField fx:id="lastNameField" prefHeight="35.0" promptText="Enter student's last name" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                    </children>
                </VBox>

                <VBox spacing="4.0">
                    <children>
                        <Label text="EMAIL ADDRESS *" textFill="#555555"><font><Font name="System Bold" size="10.0" /></font></Label>
                        <TextField fx:id="emailField" prefHeight="35.0" promptText="e.g., student.name@pup.edu.ph" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                    </children>
                </VBox>

                <GridPane hgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="180.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="105.0" minWidth="10.0" prefWidth="33.0" />
                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="194.0" minWidth="10.0" prefWidth="194.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="55.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                    <children>
                        <VBox spacing="4.0" GridPane.columnIndex="0">
                            <children>
                                <Label text="COURSE *" textFill="#555555"><font><Font name="System Bold" size="10.0" /></font></Label>
                                <TextField fx:id="courseField" prefHeight="35.0" promptText="e.g., BSIT, BSA, BSECE ...." style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                            </children>
                        </VBox>
                        <VBox prefHeight="55.0" prefWidth="159.0" spacing="4.0" GridPane.columnIndex="2">
                            <children>
                                <Label text="MOBILE NUMBER" textFill="#555555"><font><Font name="System Bold" size="10.0" /></font></Label>
                                <TextField fx:id="mobileField" prefHeight="35.0" promptText="e.g., 09XX-XXXX-XXXX" style="-fx-background-color: #F7F5F5; -fx-border-color: #E2DDD9; -fx-border-radius: 6;" />
                            </children>
                        </VBox>
                    </children>
                </GridPane>
            </children>
        </VBox>

        <HBox alignment="CENTER_RIGHT" spacing="15.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleCancelAction" prefHeight="35.0" prefWidth="90.0" style="-fx-background-color: white; -fx-text-fill: #444444; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;" text="CANCEL" />
                <Button mnemonicParsing="false" onAction="#handleSaveStudentAction" prefHeight="35.0" prefWidth="140.0" style="-fx-background-color: #500A0E; -fx-text-fill: white; -fx-background-radius: 6; -fx-font-weight: bold; -fx-cursor: hand;" text="SAVE STUDENT" />
            </children>
        </HBox>
    </children>
</VBox>
